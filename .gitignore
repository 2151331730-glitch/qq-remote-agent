__pycache__/
*.py[cod]
.pytest_cache/

# 运行时产物（含 token、聊天内容，绝不入库）
logs/
tmp/
downloads/
bridge/tasks.db
bridge/tasks.db-*
bridge/reminders.db
bridge/reminders.db-*
# 长期记忆是私人内容（称呼、日程、偏好），只留 example
bridge/memory.md
# 聊天记录也是私人内容
bridge/transcripts/
bridge/state.json
bridge/*.bak-*
tests/tmp/
tools/*.log

# 第三方 / 大件：NapCat 是下载解压的，不入库（含 token 的配置也在这里面）
napcat/
downloads/

# 本机专用
.venv/

# 本机配置文件里有 token，入库只放 example
bridge/config.json

# 压测/监控下载的大件
tools/redis/
tools/monitor/*
!tools/monitor/prometheus.yml
!tools/monitor/dashboards/
!tools/monitor/start-monitoring.ps1
docs/bench/*.json
chat_history.json

# 私有：内部运维手册与开发日志（含真实 QQ 号、私聊内容、本机路径），只在本地保留
progress.md
CLAUDE.md
HANDOFF.md
使用说明.md
tests/tmp/
bridge/*.bak*
